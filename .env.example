# Comma-separated; browser origins that may call this API (fixes CORS). Example: http://localhost:5173,http://localhost:3000
CORS_ORIGINS=

DATABASE_URL=

DIRECT_URL=

# Supabase project (Dashboard → API → Project URL), no trailing path
SUPABASE_URL=

# JWT: HS256-only legacy tokens. Default Supabase access tokens are ES256 — use SUPABASE_URL + JWKS (no secret needed for those).
SUPABASE_JWT_SECRET=

# Server-only: Storage signed URLs, Admin API. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Fast Fill — two buckets (Dashboard → Storage): user uploads vs generated outputs
SUPABASE_STORAGE_BUCKET_FF_INPUT=
SUPABASE_STORAGE_BUCKET_FF_OUTPUT=
