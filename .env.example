# development | dev | local → richer client errors; anything else → generic 5xx bodies, stub credit off
APP_ENV=production

# Comma-separated; browser origins that may call this API (fixes CORS). Example: http://localhost:5173,http://localhost:3000
CORS_ORIGINS=

# Use the Postgres role (direct or pooler, e.g. postgres.[ref] on port 6543). That role bypasses RLS.
# Do not use anon/authenticated JWT as the DB user — inserts to stripe_purchases / wallets would fail or roll back.
DATABASE_URL=

DIRECT_URL=

# Supabase project (Dashboard → API → Project URL), no trailing path
SUPABASE_URL=

# JWT: HS256-only legacy tokens. Default Supabase access tokens are ES256 — use SUPABASE_URL + JWKS (no secret needed for those).
SUPABASE_JWT_SECRET=

# Server-only: Storage signed URLs, Admin API. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Fast Fill — two buckets (Dashboard → Storage): user uploads vs generated outputs
SUPABASE_STORAGE_BUCKET_FF_INPUT=
SUPABASE_STORAGE_BUCKET_FF_OUTPUT=

# Optional: sample / reference files not processed by FF pipeline (presign GET /jobs/ff/sample-upload)
SUPABASE_STORAGE_BUCKET_FF_SAMPLES=

# Express estimate — readable wizard render (payload.md) only. Create a dedicated Storage bucket in Supabase.
# If empty, falls back to SUPABASE_STORAGE_BUCKET_EE_OUTPUT then FF output bucket.
SUPABASE_STORAGE_BUCKET_EE_READABLE=

# Express estimate — operator final output files (presigned upload + download). Separate from readable .md.
# If empty, FF output bucket is used for EE output URLs.
SUPABASE_STORAGE_BUCKET_EE_OUTPUT=

# Seconds for signed download URLs returned on GET /jobs and /jobs/search (default 3600)
STORAGE_SIGNED_DOWNLOAD_TTL_SECONDS=3600

# Dev-only: POST /api/v1/tokens/stub/credit (requires APP_ENV=development and this true)
STUB_TOKEN_CREDIT_ENABLED=false

# App session max age from last_login_at (POST /api/v1/session/start). 0 = disable age check. Default 86400 (24h).
APP_SESSION_MAX_AGE_SECONDS=86400

# Min seconds between POST /api/v1/session/start per user (same-account spam). 0 = disable. Default 60.
APP_SESSION_START_MIN_INTERVAL_SECONDS=60

# Tokens debited when creating an EE job (POST /jobs/ee) or confirming FF draft details. 0 = skip debit.
EE_JOB_SUBMIT_TOKEN_COST=1
FF_JOB_SUBMIT_TOKEN_COST=1

# App user role lives in public.users.user_type (default customer). Back-office users:
#   - GET /api/v1/ops/jobs and GET /api/v1/ops/jobs/search — all customers' jobs (403 if not back_office)
#   - EE processing by job id (readables, output, complete/reopen); cannot POST /jobs/ee create
# Example: UPDATE public.users SET user_type = 'back_office' WHERE email = 'you@company.com';
